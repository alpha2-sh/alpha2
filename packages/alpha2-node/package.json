{
  "name": "@alpha2-sh/node",
  "version": "0.5.0",
  "license": "MIT",
  "description": "Node.js client for the alpha2 native rendering host.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpha2-sh/alpha2.git",
    "directory": "packages/alpha2-node"
  },
  "homepage": "https://github.com/alpha2-sh/alpha2#readme",
  "bugs": {
    "url": "https://github.com/alpha2-sh/alpha2/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "bin": {
    "alpha2-node": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "alpha2": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30"
  }
}
