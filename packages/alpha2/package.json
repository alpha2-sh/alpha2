{
  "name": "alpha2",
  "version": "0.5.0",
  "license": "MIT",
  "description": "JavaScript bindings for the standalone alpha2 media engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpha2-sh/alpha2.git",
    "directory": "packages/alpha2"
  },
  "homepage": "https://github.com/alpha2-sh/alpha2#readme",
