{
  "description": "Composition time at a timeline tick for a clip's composition reference (offset, scale, clip start): `time` pairs a timeline tick with the composition time the engine evaluates there (ClipComposition::local_time, offset + floor((tick - start) * num / den)); `first` pairs a composition time with the first timeline tick that shows it. alpha2-model and @alpha2-sh/editor (compositionTime, timelineTime) both read this file.",
  "cases": [
    {
      "name": "the engine's own example: offset 1000 at 2/3",
      "offset": 1000,
      "scale": { "num": 2, "den": 3 },
      "start": 120000,
      "time": [
        [120000, 1000],
        [120004, 1002],
        [120005, 1003],
        [119999, 999],
        [119998, 998],
        [240000, 81000]
      ],
      "first": [
        [1000, 120000],
        [1001, 120002],
        [1002, 120003],
        [1003, 120005],
        [999, 119999],
        [0, 118500]
      ]
    },
    {
      "name": "a negative offset: a start extended before composition time zero",
      "offset": -5000,
      "scale": { "num": 3, "den": 2 },
      "start": 0,
      "time": [
        [0, -5000],
        [1, -4999],
        [2, -4997],
        [-1, -5002],
        [-3, -5005],
        [4000, 1000]
      ],
      "first": [
        [-5000, 0],
        [-4999, 1],
        [-4998, 2],
        [-5001, 0],
        [0, 3334],
        [1, 3334]
      ]
    },
    {
      "name": "no time mapping: composition time is timeline time",
      "offset": 0,
      "start": 100,
      "time": [
        [100, 0],
        [7, -93],
        [0, -100],
        [250, 150]
      ],
      "first": [
        [100, 200],
        [7, 107],
        [-3, 97],
        [250, 350]
      ]
    },
    {
      "name": "a slowed clip at the NTSC rate, far into the timeline",
      "offset": 0,
      "scale": { "num": 1000, "den": 1001 },
      "start": 432000000,
      "time": [
        [432000000, 0],
        [432001001, 1000],
        [432001000, 999],
        [431999999, -1]
      ],
      "first": [
        [0, 432000000],
        [1000, 432001001],
        [999, 432001000],
        [-1, 431999999]
      ]
    },
    {
      "name": "an offset and a fast scale with remainders on both sides",
      "offset": -1,
      "scale": { "num": 7, "den": 5 },
      "start": 50,
      "time": [
        [50, -1],
        [51, 0],
        [52, 1],
        [49, -3],
        [48, -4],
        [-1000, -1471]
      ],
      "first": [
        [-1, 50],
        [0, 51],
        [6, 55],
        [-2, 50],
        [-9, 45],
        [700, 551]
      ]
    }
  ]
}
