{
  "schema_version": 1,
  "id": "host-first-frame-small-layer",
  "name": "First frame of a small layer over a background (the composite pipeline compiled at frame 0)",
  "settings": {
    "width": 1920,
    "height": 1080,
    "frame_rate": { "num": 30, "den": 1 },
    "sample_rate": 48000,
    "background": { "red": 0.1, "green": 0.15, "blue": 0.25 }
  },
  "sources": [
    { "id": "still", "locator": "fixture://parity-image", "kind": "image" }
  ],
  "timeline": {
    "tracks": [
      {
        "id": "video",
        "name": "Video",
        "kind": "video",
        "clips": [
          {
            "id": "badge",
            "source_id": "still",
            "timeline_range": { "start": 0, "end": 120000 },
            "source_range": { "start": 0, "end": 120000 },
            "visual": {
              "scale": { "mode": "constant", "value": { "x": 0.35, "y": 0.35 } }
            }
          }
        ]
      }
    ]
  }
}
